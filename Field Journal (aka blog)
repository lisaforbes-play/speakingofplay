}

.post-meta {
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 700;
  margin-bottom: 0.7rem;
}

.adult-post { border-top: 5px solid var(--gold); }
.culture-post { border-top: 5px solid var(--lavender); }
.therapy-post { border-top: 5px solid var(--teal); }
.learning-post { border-top: 5px solid var(--coral); }

.read-link {
