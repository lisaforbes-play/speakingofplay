}

.adult-post .read-link { color: #8b671f; }
.culture-post .read-link { color: var(--lavender); }
.therapy-post .read-link { color: var(--teal); }
.learning-post .read-link { color: var(--coral); }

@media (max-width: 800px) {
  .post-grid {
    grid-template-columns: 1fr;
  }
}

