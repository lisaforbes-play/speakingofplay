}

.blog-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 1.5rem;
}

.blog-categories a {
  display: inline-flex;
  padding: 0.65rem 1rem;
  border-radius: 999px;
  background: rgba(255, 253, 249, 0.92);
  font-size: 0.88rem;
  font-weight: 700;
}

.blog-categories a:nth-child(1) {
  border: 2px solid var(--gold);
  color: #8b671f;
}

.blog-categories a:nth-child(2) {
  border: 2px solid var(--lavender);
  color: var(--lavender);
}

.blog-categories a:nth-child(3) {
  border: 2px solid var(--teal);
  color: var(--teal);
}

.blog-categories a:nth-child(4) {
  border: 2px solid var(--coral);
  color: var(--coral);
}

.blog-section {
  scroll-margin-top: 110px;
}

.blog-section-header {
  margin-bottom: 1.2rem;
}

.post-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.post-card {
  display: flex;
  flex-direction: column;
  background: rgba(255, 253, 249, 0.92);
  border: 1px solid rgba(29, 27, 26, 0.08);
  border-radius: 22px;
  padding: 1.25rem;
  min-height: 220px;
}

.post-card h3 {
